# Confluent Cloud Configuration
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CONFLUENT_API_KEY=your-api-key
CONFLUENT_API_SECRET=your-api-secret
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=your-schema-registry-key
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=your-schema-registry-secret

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Simulation Settings
NUM_WORKERS=10
SIMULATION_SPEED=1.0  # 1.0 = real-time, 10.0 = 10x faster

# MQTT Broker Configuration (optional - for IoT device simulation)
MQTT_BROKER_HOST=your-mqtt-broker-host
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
